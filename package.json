{
  "name": "youtube-reload",
  "version": "5.1.1",
  "license": "MIT",
  "homepage": "https://gabrielogregorio.github.io/youtube-reload",
  "private": false,
  "main": "build/index.js",
  "engines": {
    "node": ">=24 <25",
    "pnpm": ">=12"
  },
  "packageManager": "pnpm@12.16.1",
  "scripts": {
    "dev": "vite --host",
    "build": "vite build",
    "preview": "vite preview",
    "unit": "vitest",
    "unit:coverage": "vitest --coverage --watch=false",
    "unit:ui": "vitest --ui",
    "unit:preview": "vite preview --host --port=5556",
    "e2e": "start-server-and-test _build_start_app http-get://127.0.0.1:5556/youtube-reload/ _headless:all",
    "e2e:ui": "start-server-and-test _starting_dev_app http-get://127.0.0.1:5556/youtube-reload/ _open",
    "e2e:local": "start-server-and-test _starting_dev_app http-get://127.0.0.1:5556/youtube-reload/ _headless",
    "e2e:features": "start-server-and-test _start_prod_app http-get://127.0.0.1:5556/youtube-reload/ _headless:tests",
    "e2e:accessibility": "start-server-and-test _start_prod_app http-get://127.0.0.1:5556/youtube-reload/ _headless:accessibility",
    "check:all": "pnpm run format:check && pnpm run lint && pnpm run unit:coverage && pnpm run e2e",
    "format": "prettier \"src/**/*.{ts,js,md,tsx,jsx}\" \"cypress/**/*.ts\" --write",
    "lint": "eslint . && tsc -p . && tsc -p cypress",
    "lint:fix": "eslint . --fix",
    "format:check": "prettier \"src/**/*.{ts,js,md,tsx,jsx}\" \"cypress/**/*.ts\" --check",
    "clear:env": "rm -rf build coverage lighthouseReport.html tsconfig.tsbuildinfo",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "deploy": "gh-pages -d build",
    "_open": "cypress open",
    "_headless": "cypress run --headless --browser chrome",
    "_headless:tests": "cypress run --headless --browser chrome --spec \"cypress/e2e/(tests|bdd)/**\"",
    "_build:test:and:preview": "vite preview --host --port=5556",
    "_starting_dev_app": "vite --host --port=5556",
    "_build_start_app": "pnpm run build && pnpm run _build:test:and:preview",
    "_start_prod_app": "pnpm run _build:test:and:preview",
    "_headless:accessibility": "cypress run --headless --browser chrome --spec \"cypress/e2e/accessibility/**\"",
    "e2e:lighthouse": "start-server-and-test _start_prod_app http-get://127.0.0.1:5556/youtube-reload/ _lighthouse",
    "e2e:resources": "start-server-and-test _start_prod_app http-get://127.0.0.1:5556/youtube-reload/ _resources",
    "_headless:all": "pnpm run _headless && pnpm run _lighthouse && pnpm run _resources",
    "_lighthouse": "node scripts/lighthouse.mts",
    "_resources": "node scripts/resource-usage.mts"
  },
  "dependencies": {
    "@reduxjs/toolkit": "^2.13.0",
    "@sentry/react": "^11.9.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-icons": "^5.7.0",
    "react-redux": "^9.3.1",
    "react-router-dom": "^7.18.5",
    "tailwind-merge": "^3.7.0"
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "devDependencies": {
    "@axe-core/react": "^4.14.0",
    "@badeball/cypress-cucumber-preprocessor": "28.0.1",
    "@bahmutov/cypress-esbuild-preprocessor": "^2.2.8",
    "@eslint/compat": "^2.1.1",
    "@eslint/js": "^10.0.1",
    "@sentry/vite-plugin": "^11.9.0",
    "@storybook/addon-docs": "^10.6.5",
    "@storybook/addon-links": "^10.6.5",
    "@storybook/addon-onboarding": "^10.6.5",
    "@storybook/react-vite": "^10.6.5",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/coverage-v8": "5.0.5",
    "@vitest/ui": "^5.0.5",
    "axe-core": "^4.14.0",
    "chrome-launcher": "^1.2.2",
    "cypress": "^16.2.0",
    "cypress-axe": "^1.7.0",
    "cypress-plugin-tab": "^2.0.0",
    "cypress-real-events": "^1.15.1",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-canonical-vocabulary": "^1.4.0",
    "eslint-plugin-cypress": "^7.0.2",
    "eslint-plugin-import-x": "^4.17.1",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-prettier": "^5.5.7",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-sonarjs": "^4.2.2",
    "eslint-plugin-spellcheck": "^0.0.20",
    "eslint-plugin-storybook": "^10.6.5",
    "gh-pages": "^6.3.0",
    "globals": "^17.13.0",
    "jsdom": "^30.1.3",
    "lighthouse": "^13.6.0",
    "prettier": "^3.9.10",
    "puppeteer-core": "25.16.0",
    "rollup": "^4.66.0",
    "start-server-and-test": "^3.0.13",
    "storybook": "^10.6.5",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.5",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.0.5",
    "workbox-build": "^7.4.1",
    "workbox-window": "^7.4.1"
  }
}
